# Guide

guide: {
  metrics: count: entity: 1
  metrics: count: path: 2
  metrics: count: method: 2

  entity: market_data: {
    path: "/instruments": {
      op: list: method: *GET
      op: list: transform: res: *("`body.instruments`")|top
    }
    path: "/quotes": {
      op: list: method: *GET
      op: list: transform: res: *("`body.quotes`")|top
    }
  }

}