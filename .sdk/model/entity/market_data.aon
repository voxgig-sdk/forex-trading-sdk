# Entity: market_data

main: kit: entity: market_data: {

  alias: field: {}

  fields: [
    {
      format: "double"
      name: "ask"
      req: true
      short: "Current ask price"
      type: "`$NUMBER`"
    }
    {
      name: "baseCurrency"
      req: false
      short: "Base currency code"
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "bid"
      req: true
      short: "Current bid price"
      type: "`$NUMBER`"
    }
    {
      name: "category"
      req: true
      short: "Instrument category"
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "change"
      req: false
      short: "Price change from previous close"
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "changePercent"
      req: false
      short: "Percentage change from previous close"
      type: "`$NUMBER`"
    }
    {
      name: "currency"
      req: true
      short: "Quote currency"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Additional information about the instrument"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "lastUpdated"
      req: false
      short: "Last update timestamp"
      type: "`$STRING`"
    }
    {
      name: "leverage"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "lotSizes"
      req: false
      short: "Available lot sizes"
      type: "`$ARRAY`"
    }
    {
      format: "double"
      name: "marginRequirement"
      req: true
      short: "Margin requirement percentage"
      type: "`$NUMBER`"
    }
    {
      name: "minSpread"
      req: false
      short: "Minimum spreads by account type (in pips or points)"
      type: "`$OBJECT`"
    }
    {
      name: "name"
      req: true
      short: "Full name of the instrument"
      type: "`$STRING`"
    }
    {
      name: "quoteCurrency"
      req: false
      short: "Quote currency code"
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "spread"
      req: false
      short: "Spread in pips or points"
      type: "`$NUMBER`"
    }
    {
      name: "symbol"
      req: true
      short: "Trading symbol"
      type: "`$STRING`"
    }
    {
      name: "tradingHours"
      req: false
      short: "Trading hours availability"
      type: "`$STRING`"
    }
  ]

  name: "market_data"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "Standard"
                kind: "query"
                name: "account_type"
                orig: "account_type"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "all"
                kind: "query"
                name: "category"
                orig: "category"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/instruments"
          segments: [
            {
              lit: "instruments"
            }
          ]
          select: {
            exist: [
              "account_type"
              "category"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.instruments`"
          }
        }
        {
          args: {
            query: [
              {
                example: "Standard"
                kind: "query"
                name: "account_type"
                orig: "account_type"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "EUR/USD,GBP/USD,XAU/USD"
                kind: "query"
                name: "symbol"
                orig: "symbol"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/quotes"
          segments: [
            {
              lit: "quotes"
            }
          ]
          select: {
            exist: [
              "account_type"
              "symbol"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.quotes`"
          }
        }
      ]
    }
  }



}
